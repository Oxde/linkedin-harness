# Copy to .env (never commit .env). Read by feed/run_*.sh and feed/ctl.sh when the shell lacks them.

# Where the feed service runs, and its shared bearer token.
FEED_URL=http://127.0.0.1:4872
FEED_TOKEN=change-me

# Optional: raises the GitHub search rate limit for the repo lane.
GH_TOKEN=

# Optional: enables the LinkedIn post search and Instagram reels lanes (Apify).
APIFY_API_KEY=

# Own-post metrics collector (scripts/collect_linkedin_metrics.py).
LINKEDIN_ACTIVITY_URL=https://www.linkedin.com/in/<vanity>/recent-activity/all/
LINKEDIN_METRICS_DIR=/durable/path/own-post-metrics
